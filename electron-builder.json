{
  "appId": "com.markettracker.app",
  "productName": "MarketTracker",
  "icon": "build/icon.png",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/**/*",
    "dist/renderer/**/*"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icon.png"
    }
  ],
  "mac": {
    "category": "public.app-category.finance",
    "target": "dmg"
  },
  "win": {
    "target": "nsis"
  },
  "linux": {
    "target": "AppImage"
  }
}
